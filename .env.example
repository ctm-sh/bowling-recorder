# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Settings → API Keys → Secret key (sb_secret_...). 서버 전용, 절대 공개 금지
SUPABASE_SECRET_KEY=

# 운영진 공용 비밀번호
ADMIN_PASSWORD=
# 세션 쿠키 서명 키 (32자 이상 임의 문자열)
SESSION_SECRET=

# 구글 시트 내보내기 (선택). 서비스 계정 JSON 키의 client_email / private_key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 줄바꿈은 \n 으로 이어서 한 줄로, 큰따옴표로 감싸기: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
